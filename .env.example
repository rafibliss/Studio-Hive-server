# Copy this file to .env and fill in real values. Never commit the real .env.

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>

# Frontend origin. Drives CORS and JWT verification:
#   - CORS allows credentialed requests from this origin only
#   - Better Auth JWTs are verified with `jose` against this origin's JWKS
#     (<CLIENT_URL>/api/auth/jwks, EdDSA) with issuer/audience = CLIENT_URL
# NOTE: no secrets live here — the backend holds no signing keys. All
# authentication (and the BETTER_AUTH_SECRET that signs JWTs) is owned by the
# Next.js frontend.
CLIENT_URL=http://localhost:3000
